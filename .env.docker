# ╔══════════════════════════════════════════════════════════╗
# ║  GGNF Backend — Docker Environment Template             ║
# ║  Copy this to .env and fill in real values before       ║
# ║  running `docker compose up`.                           ║
# ║                                                          ║
# ║  ⚠ NEVER commit .env to git.                            ║
# ╚══════════════════════════════════════════════════════════╝

# ── Application ──────────────────────────────────────────────
APP_NAME="GGNF Backend"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Generate with: php artisan key:generate --show
APP_KEY=base64:AXG33hFwhBeFv2kyf6tAGMRHaoZjKvUiiAjdeQUFY94=

# Port Nginx listens on (host side)
APP_PORT=80

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database — Aiven Managed MySQL ──────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql-2fd82d31-emmanuelnwigwe87-d318.l.aivencloud.com
DB_PORT=16755
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=REPLACE_WITH_YOUR_AIVEN_PASSWORD
# Aiven enforces SSL — keep this as true
MYSQL_ATTR_SSL_CA=true

# ── Cache / Session / Queue ───────────────────────────────────
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── CORS / Sanctum ───────────────────────────────────────────
FRONTEND_URL=https://ggnfngo.vercel.app
SANCTUM_STATEFUL_DOMAINS=ggnfngo.vercel.app,localhost:3000,localhost,127.0.0.1

# Token expiry in minutes (1440 = 24 hours)
SANCTUM_TOKEN_EXPIRATION=1440

# ── Paystack ─────────────────────────────────────────────────
# Use your LIVE secret key in production
PAYSTACK_SECRET_KEY=REPLACE_ME

# ── Mail ─────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ggnf.org"
MAIL_FROM_NAME="${APP_NAME}"

# ── Broadcasting ─────────────────────────────────────────────
BROADCAST_DRIVER=log
